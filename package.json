{
  "name": "whatsapp-mcp-plus",
  "version": "0.1.0",
  "description": "A secure, zero-setup WhatsApp MCP server. Read-first and safe by default. Maintained successor to the abandoned lharries/whatsapp-mcp.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "whatsapp-mcp-plus": "dist/index.js",
    "wamcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:logic": "node test/logic-test.mjs",
    "test:features": "node test/features-test.mjs",
    "test:bughunt": "node test/bughunt-test.mjs",
    "test:pure": "node test/pure-test.mjs",
    "test:guard": "node test/guard-test.mjs",
    "test:security": "node test/security-test.mjs",
    "test:harden": "node test/harden-test.mjs",
    "test:safety": "node test/safety-test.mjs",
    "test:mcp": "node test/smoke-mcp.mjs",
    "test:call": "node test/smoke-call.mjs",
    "test": "npm run build && npm run test:pure && npm run test:guard && npm run test:security && npm run test:harden && npm run test:safety && npm run test:logic && npm run test:features && npm run test:bughunt && npm run test:mcp",
    "demo": "npm run build && node scripts/demo.mjs",
    "card": "npm run build && node scripts/gen-sample-card.mjs",
    "rewind": "npm run build && node scripts/gen-rewind.mjs"
  },
  "keywords": [
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "claude",
    "baileys",
    "ai",
    "assistant"
  ],
  "author": "eeshsaxena",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eeshsaxena/whatsapp-mcp-plus.git"
  },
  "bugs": {
    "url": "https://github.com/eeshsaxena/whatsapp-mcp-plus/issues"
  },
  "homepage": "https://github.com/eeshsaxena/whatsapp-mcp-plus#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "baileys": "^6.7.18",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.14",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0"
  }
}
