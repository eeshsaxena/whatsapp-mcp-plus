# whatsapp-mcp-plus configuration (all optional). Copy to .env or set in the MCP
# client's "env" block. Defaults are the safe-by-default values.

# Safety mode: read-only (default) | assisted | unrestricted
WAMCP_MODE=read-only

# Where the SQLite DB, logs, and downloaded media live.
WAMCP_DATA_DIR=./data
# Where WhatsApp pairing credentials are stored.
WAMCP_AUTH_DIR=./auth_info

# Safety rails (default ON outside unrestricted mode).
WAMCP_ALLOWLIST_ONLY=true      # only message known contacts / people who messaged you first
WAMCP_REQUIRE_CONFIRM=true     # two-step confirm before any send

# Rate limiting (anti-ban).
WAMCP_RATE_PER_MINUTE=8
WAMCP_RATE_PER_DAY=200
WAMCP_MIN_GAP_MS=3000
WAMCP_JITTER_MS=2500

# Persist the raw message proto so media download / true forward work for any
# synced message (not just recent ones). Costs DB space.
WAMCP_STORE_RAW=true

# Pull full message history from WhatsApp on first pairing (default ON). Without
# it a fresh pair only gets the contact + chat list, so analytics start empty.
WAMCP_SYNC_FULL_HISTORY=true

# Privacy mode (default ON). Before any result is returned to the LLM, real
# identifiers (JIDs, phone numbers, emails, contact names) are pseudonymized to
# stable local aliases (reversed automatically when the model uses them), and
# structured secrets in message text (cards, gov IDs, API keys, OTP codes) are
# redacted. Set to 0 to send real values to the model.
WAMCP_PRIVACY=true

# Anti-exfiltration: if set, files can only be SENT from these directories
# (comma-separated). Empty = no root restriction, BUT an always-on denylist
# still blocks credential/secret files (.env, SSH keys, *.pem, auth_info/, the
# message DB) regardless of this setting.
# WAMCP_SEND_FILE_ROOTS=/home/me/Pictures,/home/me/Downloads

# Max size (MB) accepted when downloading media (anti disk/memory DoS).
WAMCP_MAX_MEDIA_MB=100

# Voice-note transcription: a command template containing {input} that prints a
# transcript to stdout. Example (whisper):
# WAMCP_TRANSCRIPTION_CMD=whisper {input} --model base --output_format txt --output_dir -

# Logging level: trace | debug | info | warn | error
WAMCP_LOG_LEVEL=info

# Run the MCP server WITHOUT connecting to WhatsApp (used by tests/demo).
# WAMCP_NO_WA=1
